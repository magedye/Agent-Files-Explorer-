 {id:'E2.a',status:'IMPLEMENTED_AND_TESTED',files:['tools/validate.py'],evidence:['test_validate.StructuralTests','real-strict.stdout.json','missing-level-must.stdout.json','missing-level-must_not.stdout.json'],scope:'Locked schemas, force/severity tiers and date checks; no authority.level means INVALID'},
 {id:'E2.b',status:'IMPLEMENTED_AND_TESTED',files:['tools/scope.py'],evidence:['test_scope.ScopeTests','test_evidence.PipelineTests.test_arabic_and_english_preserve_targeted_item_ids','test_e2_cli.GoverningCliTests.test_language_changes_rendering_only'],scope:'POSIX scope dimensions, exclusion first, language only rendering, explicit missing-context blocks'},
 {id:'E2.c',status:'IMPLEMENTED_AND_TESTED',files:['tools/authority.py','tools/conflicts.py'],evidence:['test_authority.AuthorityTests','test_authority.ConflictTests','self-enterprise.stdout.json'],scope:'Bound caller attestations, no file self-certification, explicit graph and conservative conflict order'},
 {id:'E2.d',status:'IMPLEMENTED_AND_TESTED',files:['tools/evidence.py','tools/lint.py'],evidence:['test_evidence.EvidenceTests','test_evidence.DocumentationTests','unproven-calibration.stdout.json'],scope:'Missing qualification/enforcement/calibration/approval evidence blocks; documentation count check; no E3-E6 execution'},
 {id:'E2.e',status:'IMPLEMENTED_AND_TESTED',files:['tools/cli.py','CLI_CONTRACT.json','E2_PROFILE.md'],evidence:['test_e2_cli.GoverningCliTests','CLI_TRANSCRIPT.json','DISTRIBUTION.json'],scope:'Actual validate/lint subprocess, codes 0/1/2/3, raw streams, source/input hashes, local archive relocation and tested zero-write boundary'}
];
await put('E2_ACCEPTANCE.json',{status:'TECHNICAL_WORK_COMPLETE_FOR_OWNER_REVIEW',completed_local_date:'2026-10-23',started_local_date:'2026-10-22',source_hash:pin.source_hash,E1:'ACCEPTED_BY_OWNER',E2:stageRows,owner_acceptance_of_E2:'NOT_SELF_GRANTED',T01:'BLOCKED_NOT_CLOSED',T01_reentry:'NOT_RUN',T02:'NOT_STARTED',native_host_qualification:'NOT_RUN',independent_review:'NOT_PERFORMED',release_acceptance:'NOT_GRANTED'});
const gaps=[
