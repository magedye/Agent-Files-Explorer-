import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
const root='D:/APP/Agent-Files-Explorer';
const prefix='governance_packages/candidates/AGHR_rc3_Core_Candidate/';
const ev='docs/evidence/studio-e2-2026-10-22/';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=async p=>JSON.parse(await fs.readFile(path.join(root,p),'utf8'));
const put=async(name,data)=>fs.writeFile(path.join(root,ev,name),JSON.stringify(data,null,2)+'\n','utf8');
const tests=await read(ev+'TEST_RESULTS.json');const pin=await read(ev+'SOURCE_PIN.json');
if(tests.status!=='PASS_FOR_FROZEN_E2_CORE_AND_STUDIO_REGRESSION'||tests.source_hash!==pin.source_hash)throw Error('Final candidate tests not passed');
const cli=await read(ev+'CLI_TRANSCRIPT.json');const dist=await read(ev+'DISTRIBUTION.json');
if(cli.source_hash!==pin.source_hash||dist.source_hash!==pin.source_hash||cli.invocations.length!==9)throw Error('Delivery evidence differs from frozen source');
for(const [p,h]of Object.entries(pin.files))if(sha(await fs.readFile(path.join(root,prefix,p)))!==h)throw Error('Frozen source changed '+p);
const pre=await read(ev+'PREFLIGHT.json');
const mutable=new Set(pre.before.map(x=>x.path));
const protectedChecks=[];
for(const item of pre.protected_inputs){if(mutable.has(item.path))continue;const b=await fs.readFile(path.join(root,item.path));protectedChecks.push({path:item.path,sha256:sha(b),unchanged:b.length===item.bytes&&sha(b)===item.sha256});}
if(protectedChecks.some(x=>!x.unchanged))throw Error('Protected input changed '+JSON.stringify(protectedChecks.filter(x=>!x.unchanged)));
const assets=Object.keys(pin.files).filter(p=>p.startsWith('schemas/'));
const firstPin=await read('docs/evidence/studio-e1d-2026-10-22/SOURCE_PIN.json');
if(assets.some(p=>pin.files[p]!==firstPin.files[p]))throw Error('Frozen schema asset changed');
const git=async(args)=>(await promisify(execFile)('git',args,{cwd:root,encoding:'utf8',timeout:90000,maxBuffer:4*1024*1024})).stdout;
const oldEvidence=['docs/evidence/studio-e1a-2026-10-22','docs/evidence/studio-e1b-2026-10-22','docs/evidence/studio-e1c-2026-10-22','docs/evidence/studio-e1d-2026-10-22'];
const oldChanges=await git(['diff','--name-only','HEAD','--',...oldEvidence]);
if(oldChanges.trim())throw Error('Prior E1 evidence changed');
const CANDIDATE_TOTAL=tests.candidate.total;
