cli.compatibility='Intentional internal protocol 2 -> 3; no consumer bridge configured. E3+ commands remain BLOCKED. No locked Studio contract changes.';
contract.$defs.Response.properties.protocol_version.const='3';
contract.$defs.Source.properties.artifacts.items.properties.path.description='Owned raw-byte source inventory, including E2 code/tests/profile; paths are relative POSIX.';
Object.assign(contract.$defs.Diagnostic.properties,{pointer:{type:'string'},item_id:{type:['string','null']},disposition:{enum:['INVALID','BLOCKED','WARNING']}});
contract.$defs.Finding={type:'object',additionalProperties:false,required:['code','message','path','pointer','item_id','line','column','byte_offset','disposition'],properties:{...contract.$defs.Diagnostic.properties}};
const stage={type:'object',additionalProperties:false,required:['status'],properties:{status:{enum:['PASS','FAIL','BLOCKED','NOT_RUN','NOT_APPLICABLE']},reason:{type:'string'},registered:{type:'integer',minimum:0},documented:{type:'integer',minimum:0},scope:{type:'string'}}};
contract.$defs.Validation={type:'object',additionalProperties:false,required:['profile','result','exit_code','findings','stages','items','authority','resolutions','conflict_coverage','qualification','runtime_honesty','publisher_authentication','governance_release_acceptance'],properties:{
profile:{const:'E2_PACKAGE_READ_VALIDATE_LINT'},result:{enum:['VALID','INVALID','BLOCKED']},exit_code:{enum:[0,1,3]},findings:{type:'array',items:{$ref:'#/$defs/Finding'}},
stages:{type:'object',required:['structure','scope','authority','conflicts','evidence','documentation'],additionalProperties:stage},
items:{type:'array',items:{type:'object',additionalProperties:false,required:['id','location','applicability','presentation'],properties:{id:{type:'string'},location:{$ref:'#/$defs/Location'},applicability:{type:'object'},presentation:{type:'object'}}}},
authority:{type:'object',additionalProperties:{type:'object',additionalProperties:false,required:['status','level','evidence_ref'],properties:{status:{enum:['UNCLAIMED','UNKNOWN','CALLER_ATTESTED']},level:{type:['string','null']},evidence_ref:{type:['string','null']},reviewed_kinds:{type:'array',items:{type:'string'}}}}},
resolutions:{type:'array',items:{type:'object',additionalProperties:false,required:['items','status','winner','reason'],properties:{items:{type:'array',minItems:2,maxItems:2,items:{type:'string'}},status:{enum:['RESOLVED','BLOCKED','UNRESOLVED']},winner:{type:['string','null']},reason:{type:'string'}}}},
conflict_coverage:{const:'Explicit relationships only; free-text semantic conflicts not claimed resolved'},qualification:{const:'NOT_RUN'},runtime_honesty:{const:'7 REQUIRED / NOT_RUN / NOT_WAIVED; E4 deferred'},publisher_authentication:{const:'UNKNOWN'},governance_release_acceptance:{const:'NOT_GRANTED'}
}};
const dataSchema={type:'object',additionalProperties:false,required:['catalog','validation'],properties:{catalog:{$ref:'#/$defs/Catalog'},validation:{$ref:'#/$defs/Validation'}}};
contract.$defs.Response.properties.data.oneOf.push(dataSchema);
for(const [result,code]of [['VALID',0],['INVALID',1]])contract.$defs.Response.allOf.push({if:{properties:{result:{const:result}}},then:{properties:{data:{...dataSchema,properties:{...dataSchema.properties,validation:{allOf:[{$ref:'#/$defs/Validation'},{properties:{result:{const:result},exit_code:{const:code}}}]}}}}}});
const warningOnly={properties:{findings:{items:{properties:{disposition:{const:'WARNING'}}}}}};
contract.$defs.Response.allOf.push({if:{properties:{result:{const:'VALID'}}},then:{properties:{data:{properties:{validation:warningOnly}}}}});
await write('CLI_CONTRACT.json',contract);
