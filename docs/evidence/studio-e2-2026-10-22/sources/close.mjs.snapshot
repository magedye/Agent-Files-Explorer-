import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import {spawn} from 'node:child_process';
const root='D:/APP/Agent-Files-Explorer';
const ev='docs/evidence/studio-e2-2026-10-22/';
const prefix='governance_packages/candidates/AGHR_rc3_Core_Candidate/';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=async p=>JSON.parse(await fs.readFile(path.join(root,p),'utf8'));
const write=async(p,v)=>fs.writeFile(path.join(root,ev,p),JSON.stringify(v,null,2)+'\n','utf8');
async function run(exe,args,label){
 const started=new Date().toISOString();
 const result=await new Promise((resolve,reject)=>{const p=spawn(exe,args,{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe']});const stdout=[],stderr=[];p.stdout.on('data',b=>stdout.push(b));p.stderr.on('data',b=>stderr.push(b));p.on('error',reject);p.on('close',code=>resolve({code,stdout:Buffer.concat(stdout),stderr:Buffer.concat(stderr)}));});
 await fs.writeFile(path.join(root,ev,label+'.stdout.txt'),result.stdout);await fs.writeFile(path.join(root,ev,label+'.stderr.txt'),result.stderr);
 const receipt={executable:exe,args,cwd:root,started_at:started,ended_at:new Date().toISOString(),exit_code:result.code,stdout:label+'.stdout.txt',stderr:label+'.stderr.txt'};
 await write(label+'.execution.json',receipt);return {...result,receipt};
}
const pin=await read(ev+'SOURCE_PIN.json');const tests=await read(ev+'TEST_RESULTS.json');
if(tests.source_hash!==pin.source_hash||tests.candidate.failed||tests.studio.fail)throw Error('Invalid test receipts');
const health=process.argv.includes('--reuse-context')?{code:(await read(ev+'context-health.execution.json')).exit_code,stdout:await fs.readFile(path.join(root,ev,'context-health.stdout.txt')),stderr:await fs.readFile(path.join(root,ev,'context-health.stderr.txt'))}:await run(process.execPath,['tools/check_context_health.mjs'],'context-health');
await fs.writeFile(path.join(root,ev,'context-health.log'),Buffer.concat([health.stdout,health.stderr]));
const healthText=health.stdout.toString();
console.log(healthText);
if(health.code!==0||!/^Errors: 0, Warnings: 0\s*$/m.test(healthText))throw Error('Context health not fully clean');
const whitespace=await run('git',['diff','--check'],'git-diff-check');
if(whitespace.code!==0)throw Error('Tracked diff whitespace failure; inspect log');
const gitStatus=await run('git',['status','--short'],'git-status');
const head=await run('git',['rev-parse','HEAD'],'git-head');
const branch=await run('git',['branch','--show-current'],'git-branch');
const diffs=await read(ev+'DIFFS.json');
for(const patch of diffs.patches){const b=await fs.readFile(path.join(root,patch.path));if(sha(b)!==patch.after_sha256)throw Error('After diff hash mismatch '+patch.path);}
for(const [name,digest]of Object.entries(pin.files)){const b=await fs.readFile(path.join(root,prefix,name));if(sha(b)!==digest)throw Error('Frozen source changed '+name);if(/\.(py|md)$/.test(name)&&/[^\r\n][\t ]+\r?$/m.test(b.toString('utf8')))throw Error('Owned source trailing whitespace '+name);}
const docs=['docs/status/CURRENT.md','docs/status/HANDOFF.md','docs/plans/STUDIO_E1_E2_CORE_SCOPE_AR.md','docs/plans/STUDIO_UPGRADE_TASKS_AR.md'];
const protectedReceipt=await read(ev+'EVIDENCE_CHECKS.json');
for(const entry of protectedReceipt.protected_inputs)if(sha(await fs.readFile(path.join(root,entry.path)))!==entry.sha256)throw Error('Protected input changed '+entry.path);
await fs.copyFile(path.join(root,'temp/studio-e2-20261022/close.mjs'),path.join(root,ev,'sources/close.mjs.snapshot'));
const summary={status:'COMPLETE_FOR_E2_STATIC_READ_VALIDATE_LINT_PROFILE',completed_at_utc:new Date().toISOString(),completed_local_date:'2026-10-23',base_head:head.stdout.toString().trim(),branch:branch.stdout.toString().trim(),source_hash:pin.source_hash,source_files:Object.keys(pin.files).length,candidate_tests:tests.candidate,studio_tests:tests.studio,context_health:{status:'PASS',errors:0,warnings:0,log:'context-health.log'},diff_check:{exit_code:whitespace.code,receipt:'git-diff-check.execution.json'},before_after:diffs.patches.length,unchanged_source_files:diffs.unchanged.length,protected_inputs:protectedReceipt.protected_inputs.length,E1:'ACCEPTED_BY_OWNER',E2:'IMPLEMENTED_AND_TESTED; owner acceptance not self-granted',T01:'BLOCKED_NOT_CLOSED',T01_reentry:'NOT_RUN',T02:'NOT_STARTED',runtime_honesty:'7 REQUIRED / NOT_RUN / NOT_WAIVED; E4 deferred',whole_Studio_SOURCE_01:'REQUIRED / NOT_RUN / NOT_WAIVED',owner_license:'PROVISIONAL_OWNER_LICENSE',final_signature:'DEFERRED',reference_default:'1.2.0',candidate_1_3_0:'PRESERVED',engine_binding:'NOT_CONFIGURED',native_host_qualification:'NOT_RUN',independent_review:'NOT_PERFORMED',release_acceptance:'NOT_GRANTED',next_action:'Owner review of E2 delivery, then separately authorized T01 re-entry; do not auto-start T02/SEC-001'};
await write('AFTER.json',summary);
const paths=[];
async function collect(directory){for(const entry of await fs.readdir(directory,{withFileTypes:true})){const target=path.join(directory,entry.name);if(entry.isSymbolicLink())throw Error('Evidence link forbidden');if(entry.isDirectory())await collect(target);else if(entry.isFile()&&entry.name!=='CUSTODY.lock.json')paths.push(path.relative(root,target).split(path.sep).join('/'));}}
await collect(path.join(root,ev));
paths.push(...docs,...Object.keys(pin.files).map(p=>prefix+p));
const files={};for(const p of [...new Set(paths)].sort()){const b=await fs.readFile(path.join(root,p));files[p]={sha256:sha(b),bytes:b.length};}
await write('CUSTODY.lock.json',{algorithm:'Raw SHA-256 per file; lock excludes itself only',recorded_at_utc:new Date().toISOString(),source_hash:pin.source_hash,definition:'Current 46 source artifacts, four updated documents and the complete owned E2 evidence subtree; no publisher identity or signature implied',files});
console.log(JSON.stringify({...summary,custody_files:Object.keys(files).length,working_tree:'Saved local E2 changes; Git status receipt records exact paths'}));
