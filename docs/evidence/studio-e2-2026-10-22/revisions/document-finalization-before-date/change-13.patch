+class PipelineTests(FixtureCase):
+    def test_real_observation_passes_governing_static_profile(self):
+        from e2_support import ROOT
+        report, support = validate_package(read_package(ROOT), ROOT, ScopeContext(as_of="2026-10-22"))
+        self.assertEqual(report["result"], "VALID")
+        self.assertEqual(report["qualification"], "NOT_RUN")
+        self.assertEqual(support[0].path, "SOURCE_MAP.json")
+
+    def test_complete_must_passes_only_with_external_bound_grant(self):
+        from test_authority import grants
+        root = self.fixture(item(force="MUST")); package = read_package(root)
+        self.assertEqual(validate_package(package, root, ScopeContext())[0]["result"], "BLOCKED")
+        report, _ = validate_package(package, root, ScopeContext(), grants=grants(package))
+        self.assertEqual(report["result"], "VALID")
+        self.assertEqual(report["authority"]["SYNTHETIC"]["status"], "CALLER_ATTESTED")
+
+    def test_invalid_out_of_scope_item_still_rejects_whole_package(self):
+        value = item(force="MUST"); del value["authority"]["level"]
+        value["scope"]["paths"] = ["other/**"]
+        root = self.fixture(value)
+        report, _ = validate_package(read_package(root), root, ScopeContext(path="src/a.py"))
+        self.assertEqual(report["result"], "INVALID")
+        self.assertEqual(report["stages"]["authority"]["status"], "NOT_RUN")
+
+    def test_unknown_auxiliary_schema_blocks_without_fabricating_one(self):
+        root = self.fixture(); self.write(root, "profiles/local.json", {"opaque": True})
+        report, _ = validate_package(read_package(root), root, ScopeContext())
+        self.assertEqual(report["result"], "BLOCKED")
+        self.assertIn("AUXILIARY_SCHEMA_UNAVAILABLE", [e["code"] for e in report["findings"]])
+
+    def test_arabic_and_english_preserve_targeted_item_ids(self):
+        value = item(); value["scope"] = {"paths": ["src/**"], "language": ["en"]}
+        root = self.fixture(value); package = read_package(root)
+        reports = [validate_package(package, root, ScopeContext(path="src/a.py", language=lang))[0] for lang in ("ar", "en")]
+        self.assertEqual([r["result"] for r in reports], ["VALID", "VALID"])
+        self.assertEqual(reports[0]["items"][0]["applicability"], reports[1]["items"][0]["applicability"])
+        self.assertTrue(reports[0]["items"][0]["presentation"]["translation_unavailable"])
+
+    def test_targeted_missing_scope_context_cannot_be_guessed(self):
+        value = item(); value["scope"] = {"appliesToAgents": ["codex"]}
+        root = self.fixture(value)
+        report, _ = validate_package(read_package(root), root, ScopeContext(path="src/a"))
+        self.assertEqual(report["result"], "BLOCKED")
+
+    def test_invalid_globs_fail_even_without_a_selected_task(self):
+        value = item(); value["scope"] = {"paths": ["../outside/**"]}
+        root = self.fixture(value)
+        report, _ = validate_package(read_package(root), root, ScopeContext())
+        self.assertEqual(report["result"], "INVALID")
