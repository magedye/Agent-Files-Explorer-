"""E2.d: preserve unavailable evidence; never execute E4 honesty checks."""

from copy import deepcopy
from e2_support import FixtureCase, item
from evidence import check_evidence, check_documentation
from diagnostics import ReadFailure
from loader import read_package
from scope import ScopeContext


class EvidenceTests(FixtureCase):
    context = ScopeContext(as_of="2026-10-22")

    def codes(self, values, context=None):
        return {e["code"] for e in check_evidence(self.package(values), context or self.context)}

    def test_plain_observation_needs_no_invented_evidence(self):
        self.assertEqual(self.codes(item()), set())

    def test_qualified_text_and_referenced_result_do_not_prove_qualification(self):
        cap = item(kind="CAPABILITY")
        cap["skillQualification"].update(status="QUALIFIED", qualifiedAt="2026-10-20", evidence=["self-asserted-pass.json"])
        self.assertIn("QUALIFICATION_E4_EVIDENCE_UNAVAILABLE", self.codes(cap))

    def test_host_version_and_qualification_age_are_checked_without_running_host(self):
        cap = item(kind="CAPABILITY"); cap["maxAgeDays"] = 1
        cap["skillQualification"].update(status="QUALIFIED", qualifiedAt="2026-10-01", evidence=["old.json"])
        self.assertIn("STALE_OR_FUTURE_QUALIFICATION", self.codes(cap))
        self.assertIn("QUALIFICATION_CONTEXT_MISMATCH", self.codes(cap, ScopeContext(agent="codex", host_version="changed", as_of="2026-10-22")))

    def test_unknown_skill_and_each_multi_skill_coverage_reject(self):
        cap = item("KNOWN", kind="CAPABILITY"); rule = item("USES")
        rule["scope"]["skillIds"] = ["KNOWN", "MISSING"]
        rule["skillQualification"] = deepcopy(cap["skillQualification"])
        codes = self.codes([cap, rule])
        self.assertIn("UNKNOWN_ID", codes); self.assertIn("QUALIFICATION_COVERAGE_MISSING", codes)

    def test_conflicting_records_with_same_four_key_identity_reject(self):
        cap = item(kind="CAPABILITY"); changed = deepcopy(cap["skillQualification"])
        changed["status"] = "FAILED"; cap["skillQualification"] = [cap["skillQualification"], changed]
        self.assertIn("QUALIFICATION_IDENTITY_CONFLICT", self.codes(cap))

    def test_required_host_and_minimum_qualification_are_not_assumed(self):
        cap = item(kind="CAPABILITY"); cap.update(requiredOnHosts=["antigravity"], minimumStatus="QUALIFIED")
        codes = self.codes(cap)
        self.assertIn("QUALIFICATION_HOST_COVERAGE_MISSING", codes)
        self.assertIn("QUALIFICATION_E4_EVIDENCE_UNAVAILABLE", codes)

    def test_calibration_claim_is_blocked_even_when_numbers_exist(self):
        value = item(); value["impact"] = {"evidence": "repo-measured", "lastCalibrated": "2026-10-20", "measuredDelta": 0.99}
        self.assertIn("CALIBRATION_E5_EVIDENCE_UNAVAILABLE", self.codes(value))

    def test_gate_name_and_p0_priority_never_substitute_for_execution(self):
        value = item(); value["enforcement"] = {"gate": {"type": "present-file", "required": True}}
        self.assertIn("ENFORCEMENT_E3_EVIDENCE_UNAVAILABLE", self.codes(value))
        cap = item(kind="CAPABILITY"); cap["defaultTier"] = "P0-Safety"
        self.assertIn("P0_EVAL_QUALIFICATION_UNAVAILABLE", self.codes(cap))

    def test_exception_expiry_target_and_parent_permission_are_independent(self):
        exception = item("WAIVER", kind="EXCEPTION"); exception["expiresOn"] = "2026-10-21"
        codes = self.codes(exception)
        self.assertIn("EXCEPTION_EXPIRED", codes); self.assertIn("UNKNOWN_EXCEPTION_TARGET", codes)
        target = item("SYNTHETIC-TARGET")
        self.assertIn("EXCEPTION_NOT_ALLOWED", self.codes([exception, target]))
        target["exceptions"] = {"allowed": True}; exception["expiresOn"] = "2026-10-22"
        self.assertEqual(self.codes([exception, target]), {"EXCEPTION_E5_APPROVAL_UNAVAILABLE"})

    def test_local_unknown_alternatives_and_request_id_reject(self):
        cap = item(kind="CAPABILITY"); cap["alternatives"] = ["UNKNOWN"]
        self.assertIn("UNKNOWN_ID", self.codes(cap))
        self.assertIn("UNKNOWN_ID", self.codes(item(), ScopeContext(skill_id="UNKNOWN")))


class DocumentationTests(FixtureCase):
    def library(self, count=2):
        root = self.fixture()
        mapping = {"register_path": "optional_skills/REGISTER.json", "document_path": "options/SKILLS.md",
                   "register_format": "skills-array-v1", "document_format": "numbered-headings-v1"}
        self.write(root, "SOURCE_MAP.json", {"skills_documentation": mapping})
        self.write(root, mapping["register_path"], {"skills": [{"id": "first"}, {"id": "second"}]})
        document = root / mapping["document_path"]; document.parent.mkdir()
        document.write_text("# Skills\n" + "".join(f"## {i + 1}. Synthetic skill\n" for i in range(count)), encoding="utf-8")
        return root

    def test_absent_library_is_explicitly_not_applicable(self):
        root = self.fixture(); issues, sources, status = check_documentation(read_package(root), root)
        self.assertEqual(issues, []); self.assertEqual(status["status"], "NOT_APPLICABLE")
        self.assertTrue(status["reason"])

    def test_equal_counts_pass_and_original_bytes_remain_unchanged(self):
        root = self.library(); paths = ("SOURCE_MAP.json", "optional_skills/REGISTER.json", "options/SKILLS.md")
        before = {p: (root / p).read_bytes() for p in paths}
        issues, sources, status = check_documentation(read_package(root), root)
        self.assertEqual(issues, []); self.assertEqual(status["status"], "PASS")
        self.assertEqual(len(sources), 3)
        self.assertEqual(before, {p: (root / p).read_bytes() for p in paths})

    def test_mismatched_counts_fail_lint_input_check(self):
        root = self.library(count=1)
        issues, _, status = check_documentation(read_package(root), root)
        self.assertEqual(status["status"], "FAIL")
        self.assertIn("SKILL_DOCUMENTATION_COUNT_MISMATCH", [e["code"] for e in issues])

    def test_missing_registry_is_an_error_never_zero_skills(self):
        root = self.library(); (root / "optional_skills/REGISTER.json").unlink()
        with self.assertRaises(ReadFailure):
            check_documentation(read_package(root), root)

    def test_library_without_mapping_blocks(self):
        root = self.fixture(); (root / "skills").mkdir()
        issues, _, _ = check_documentation(read_package(root), root)
        self.assertEqual(issues[0]["disposition"], "BLOCKED")

    def test_documentation_cannot_read_outside_selected_root(self):
        root = self.library(); mapping = {"register_path": "../outside.json", "document_path": "options/SKILLS.md", "register_format": "skills-array-v1", "document_format": "numbered-headings-v1"}
        self.write(root, "SOURCE_MAP.json", {"skills_documentation": mapping})
        with self.assertRaises(ReadFailure):
            check_documentation(read_package(root), root)
