@@ -0,0 +1,61 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://aghr.invalid/internal/cli/1",
+  "title": "Internal AGHR CLI protocol 1 — E1.a bootstrap",
+  "$comment": "Local CLI contract, not a replacement for locked Studio contract.1. Only help/version are implemented. A JSON response is one UTF-8 object and one newline on stdout; stderr is retained separately. No success is claimed for unimplemented governance commands.",
+  "x-cli": {
+    "protocol_version": "1",
+    "default_format": "json",
+    "formats": ["json", "text"],
+    "launch": { "shell": false, "python_flags": ["-I", "-B", "-X", "utf8"], "entrypoint": "tools/cli.py", "package_root": "cwd selected by the caller; not read in E1.a" },
+    "syntax": ["--help [--format json|text]", "--version [--format json|text]", "validate [--strict] [--format json|text]", "lint [--format json|text]"],
+    "implemented": ["help", "version"],
+    "blocked_until": { "validate": "E2", "lint": "E2", "generate": "E3", "check": "E3", "doctor": "E3", "eval": "E4 and T15", "qualify": "E4 and T15" },
+    "exit_codes": { "0": "Completed requested operation; E1.a metadata only", "1": "INVALID governance result; reserved for E2, never emitted as a bootstrap success", "2": "Invalid invocation or unreadable source identity", "3": "Required implementation or evidence unavailable" },
+    "identity": "sha256-path-map-v1 as defined in PROVENANCE.json; source identity is not authenticated publisher identity, a distribution or Binding.QUALIFIED.",
+    "raw_streams": "Never mix text/help into JSON stdout. Error and blocked diagnostics are also written to stderr. No user argument values are echoed on syntax errors. The last valid --format selection also controls syntax-error rendering.",
+    "writes": "None: no package/state/evidence/cache/log writes, child processes or network calls in CLI execution."
+  },
+  "$ref": "#/$defs/Response",
+  "$defs": {
+    "Digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "NullableDigest": { "oneOf": [{ "$ref": "#/$defs/Digest" }, { "type": "null" }] },
+    "Source": {
+      "type": "object", "additionalProperties": false,
+      "required": ["implementation_id", "stage", "target_spec_version", "schema_version", "content_hash", "hash_algorithm", "artifacts", "publisher_authentication", "qualification", "distribution"],
+      "properties": {
+        "implementation_id": { "const": "aghr-rc3-core-candidate" }, "stage": { "type": "string", "minLength": 1 }, "target_spec_version": { "const": "1.0.0-rc.3" }, "schema_version": { "const": "1.2" },
+        "content_hash": { "$ref": "#/$defs/Digest" }, "hash_algorithm": { "const": "sha256-path-map-v1" },
+        "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1, "description": "Source-inventory relative POSIX path; E1.a uses the five PROVENANCE.json source_files." }, "sha256": { "$ref": "#/$defs/Digest" } } } },
+        "publisher_authentication": { "const": "UNKNOWN" }, "qualification": { "const": "NOT_RUN" }, "distribution": { "type": "null" }
+      }
+    },
+    "Diagnostic": {
+      "type": "object", "additionalProperties": false, "required": ["code", "message", "stage"],
+      "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "stage": { "type": ["string", "null"] } }
+    },
+    "Response": {
+      "type": "object", "additionalProperties": false,
+      "required": ["protocol_version", "command", "result", "exit_code", "source", "inputs", "checks", "diagnostics", "data"],
+      "properties": {
+        "protocol_version": { "const": "1" },
+        "command": { "enum": [null, "help", "version", "validate", "lint", "generate", "check", "eval", "qualify", "doctor"] },
+        "result": { "enum": ["INFO", "VALID", "INVALID", "ERROR", "BLOCKED"] },
+        "exit_code": { "enum": [0, 1, 2, 3] },
+        "source": { "oneOf": [{ "$ref": "#/$defs/Source" }, { "type": "null" }] },
+        "inputs": { "type": "object", "additionalProperties": false, "required": ["candidate_hash", "config_hash", "inputs_hash", "catalog"], "properties": { "candidate_hash": { "$ref": "#/$defs/NullableDigest" }, "config_hash": { "$ref": "#/$defs/NullableDigest" }, "inputs_hash": { "$ref": "#/$defs/NullableDigest" }, "catalog": { "type": ["array", "null"], "items": { "type": "object" } } } },
+        "checks": { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "enum": ["NOT_RUN", "BLOCKED", "COMPLETE"] }, "reason": { "type": ["string", "null"] } } },
+        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
+        "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["help"], "properties": { "help": { "type": "string", "minLength": 1 } } }] }
+      },
+      "allOf": [
+        { "if": { "properties": { "result": { "const": "INFO" } } }, "then": { "properties": { "exit_code": { "const": 0 }, "command": { "enum": ["help", "version"] }, "source": { "$ref": "#/$defs/Source" }, "checks": { "properties": { "status": { "const": "NOT_RUN" } } }, "diagnostics": { "maxItems": 0 } } } },
+        { "if": { "properties": { "result": { "const": "ERROR" } } }, "then": { "properties": { "exit_code": { "const": 2 }, "diagnostics": { "minItems": 1 } } } },
+        { "if": { "properties": { "result": { "const": "BLOCKED" } } }, "then": { "properties": { "exit_code": { "const": 3 }, "source": { "$ref": "#/$defs/Source" }, "checks": { "properties": { "status": { "enum": ["NOT_RUN", "BLOCKED"] } } }, "diagnostics": { "minItems": 1 } } } },
+        { "if": { "properties": { "result": { "enum": ["VALID", "INVALID"] } } }, "then": { "properties": { "command": { "enum": ["validate", "lint"] }, "source": { "$ref": "#/$defs/Source" }, "checks": { "properties": { "status": { "const": "COMPLETE" } } }, "inputs": { "properties": { "candidate_hash": { "$ref": "#/$defs/Digest" }, "config_hash": { "$ref": "#/$defs/Digest" }, "inputs_hash": { "$ref": "#/$defs/Digest" }, "catalog": { "type": "array" } } } } } },
+        { "if": { "properties": { "result": { "const": "VALID" } } }, "then": { "properties": { "exit_code": { "const": 0 }, "diagnostics": { "maxItems": 0 } } } },
+        { "if": { "properties": { "result": { "const": "INVALID" } } }, "then": { "properties": { "exit_code": { "const": 1 }, "diagnostics": { "minItems": 1 } } } }
+      ]
+    }
+  }
+}
