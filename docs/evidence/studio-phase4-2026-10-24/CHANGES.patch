+ };
+ const receive=async file=>{
+  const p=safe(file);if(!p)return;const st=fs.lstatSync(p.absolute);if(!st.isFile()||st.nlink!==1||st.size>131072||!st.size)throw Error('INBOX_SIZE_OR_TYPE_REJECTED');
