]);const results=jobs.filter(x=>x.status==='fulfilled').map(x=>x.value);await fs.writeFile(root+ev+'RAW_TRANSCRIPT.json',JSON.stringify({source_hash:pin.source_hash,invocations:results.map(x=>x.record),rejected:jobs.filter(x=>x.status==='rejected').map(x=>String(x.reason))},null,2),{flag:'wx'});if(jobs.some(x=>x.status==='rejected')||results.some(x=>!x.ok))throw Error('FAILED_INVOCATION: retain logs and inspect');const named=Object.fromEntries(results.map(x=>[x.record.name,x]));
