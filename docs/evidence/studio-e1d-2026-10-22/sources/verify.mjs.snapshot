async function run(name,exe,args,expected,cwd=root,timeout=120000){const start=new Date().toISOString();let p,code=0;try{p=await exec(exe,args,{cwd,encoding:'buffer',timeout,maxBuffer:8*1024*1024});}catch(e){p=e;code=e.code;}const out=Buffer.isBuffer(p.stdout)?p.stdout:Buffer.from(p.stdout||''),err=Buffer.isBuffer(p.stderr)?p.stderr:Buffer.from(p.stderr||'');await fs.writeFile(root+ev+name+'.stdout.txt',out,{flag:'wx'});await fs.writeFile(root+ev+name+'.stderr.txt',err,{flag:'wx'});console.log(JSON.stringify({name,exit_code:code,expected}));return{record:{name,executable:exe,args,cwd,started_at_utc:start,completed_at_utc:new Date().toISOString(),exit_code:code,expected_exit_code:expected,stdout:name+'.stdout.txt',stderr:name+'.stderr.txt',stdout_sha256:hash(out),stderr_sha256:hash(err),source_hash:pin.source_hash},out,err,ok:code===expected};}
