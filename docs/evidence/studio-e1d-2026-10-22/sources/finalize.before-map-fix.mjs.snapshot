import fs from 'node:fs/promises';import crypto from 'node:crypto';import path from 'node:path';import {execFile as callback} from 'node:child_process';import {promisify} from 'node:util';
const exec=promisify(callback),root='D:/APP/Agent-Files-Explorer/',ev='docs/evidence/studio-e1d-2026-10-22/',cand='governance_packages/candidates/AGHR_rc3_Core_Candidate/';const hash=b=>crypto.createHash('sha256').update(b).digest('hex');const read=async f=>JSON.parse(await fs.readFile(root+ev+f,'utf8'));const write=async(f,x)=>fs.writeFile(root+ev+f,JSON.stringify(x,null,2));
const pre=await read('PREFLIGHT.json'),pin=await read('SOURCE_PIN.json');for(const x of pre.protected_inputs)if(hash(await fs.readFile(root+x.path))!==x.sha256)throw Error('PROTECTED_INPUT_CHANGED '+x.path);for(const x of pre.before)if(hash(await fs.readFile(root+x.snapshot))!==x.sha256)throw Error('BEFORE_CHANGED '+x.path);for(const [name,expected] of Object.entries(pin.files))if(hash(await fs.readFile(root+cand+name))!==expected)throw Error('PIN_CHANGED '+name);
const old=JSON.parse(await fs.readFile(root+'docs/evidence/studio-e1c-2026-10-22/AFTER.json','utf8'));const snapshots=new Map(pre.before.map(x=>[x.path,x.snapshot])),oldMap={};for(const x of old.outputs.filter(x=>x.path.startsWith(cand)).sort((a,b)=>a.path<b.path?-1:1)){const raw=await fs.readFile(root+(snapshots.get(x.path)||x.path));if(hash(raw)!==x.sha256)throw Error('OLD_SOURCE_CHANGED '+x.path);oldMap[x.path.slice(cand.length)]=hash(raw);}if(Object.keys(oldMap).length!==13||hash(Buffer.from(JSON.stringify(oldMap)))!==pre.prior_source_hash)throw Error('PRIOR_AGGREGATE');
async function enumerate(dir,prefix=''){const out=[];for(const x of await fs.readdir(dir,{withFileTypes:true})){if(x.isDirectory())out.push(...await enumerate(path.join(dir,x.name),prefix+x.name+'/'));else if(x.isFile())out.push(prefix+x.name);else throw Error('NON_REGULAR_ENTRY '+prefix+x.name);}return out.sort();}const physical=await enumerate(root+cand);if(JSON.stringify(physical)!==JSON.stringify(Object.keys(pin.files).sort()))throw Error('UNDECLARED_CANDIDATE_FILE');
const closure=JSON.parse(await fs.readFile(root+cand+'schemas/SCHEMAS.lock.json','utf8'));for(const s of closure.files){const origin=await fs.readFile(root+s.source_path),copy=await fs.readFile(root+cand+'schemas/'+s.path);if(!origin.equals(copy)||hash(copy)!==s.sha256)throw Error('SCHEMA_COPY_CHANGED '+s.path);}if(hash(await fs.readFile(root+closure.source_lock.repository_path))!==closure.source_lock.sha256)throw Error('CONTRACT_LOCK_CHANGED');
const taskIds=t=>t.split(String.fromCharCode(10)).map(x=>x.trim()).filter(x=>x.startsWith('| [')&&/[TE][0-9]/.test(x)).map(x=>x.match(/\b([TE][0-9]+[a-z]?)\b/)[1]);const oldTasks=taskIds(await fs.readFile(root+pre.before[2].snapshot,'utf8')),tasks=taskIds(await fs.readFile(root+pre.before[2].path,'utf8'));if(tasks.length!==57||JSON.stringify(tasks)!==JSON.stringify(oldTasks))throw Error('TASK_IDS_CHANGED');
const real=JSON.parse(await fs.readFile(root+ev+'catalog-real.stdout.txt','utf8'));if(real.source.content_hash!==pin.source_hash||real.result!=='READ'||real.checks.status!=='NOT_RUN')throw Error('REAL_CATALOG_PIN');for(const x of real.data.catalog.sources){const b=await fs.readFile(root+cand+x.path);if(!b.equals(Buffer.from(x.raw_base64,'base64'))||hash(b)!==x.sha256)throw Error('CAPTURE_MISMATCH');}
console.log(JSON.stringify({step:'custody_verified',protected:pre.protected_inputs.length,source_files:physical.length,schemas_byte_identical:closure.files.length,raw_captures:real.data.catalog.sources.length,task_ids:tasks.length}));
const git=async args=>exec('git',args,{cwd:root,encoding:'buffer',timeout:60000,maxBuffer:8*1024*1024});const head=(await git(['rev-parse','HEAD'])).stdout.toString('utf8').trim(),branch=(await git(['branch','--show-current'])).stdout.toString('utf8').trim();if(head!==pre.custody.head||branch!==pre.custody.branch)throw Error('GIT_CHANGED');await fs.writeFile(root+ev+'git-status-after.txt',(await git(['status','--short'])).stdout);
const diffs=[];async function diff(before,after,output){let p,code=0;try{p=await git(['diff','--no-index','--',before,after]);}catch(e){p=e;code=e.code;}if(code!==0&&code!==1)throw Error('DIFF_FAILED '+after);await fs.writeFile(root+ev+output,p.stdout);diffs.push({before,after,patch:output,exit_code:code,sha256:hash(p.stdout)});}
for(const [i,x] of pre.before.entries())await diff(x.snapshot,x.path,'change-'+String(i+1).padStart(2,'0')+'.patch');console.log(JSON.stringify({step:'existing_before_after_saved',count:diffs.length}));await fs.writeFile(root+ev+'before/empty.snapshot',Buffer.alloc(0));for(const [i,x] of pre.new_paths.entries())await diff(ev+'before/empty.snapshot',x,'add-'+String(i+1).padStart(2,'0')+'.patch');
const checked=await git(['diff','--check']);await fs.writeFile(root+ev+'git-diff-check.log',Buffer.concat([checked.stdout,checked.stderr]));const appDiff=await git(['diff','--','src','server','package.json','package-lock.json']);await fs.writeFile(root+ev+'app-boundary.diff',appDiff.stdout);if(appDiff.stdout.length)throw Error('APP_BOUNDARY_CHANGED');
const evidence={recorded_at_utc:new Date().toISOString(),protected_inputs:{count:pre.protected_inputs.length,status:'UNCHANGED'},before_snapshots:{count:pre.before.length,status:'UNCHANGED'},candidate:{files:physical,source_hash:pin.source_hash,status:'MATCHES_FINAL_PIN'},prior_candidate:{files:13,source_hash:pre.prior_source_hash,status:'RECONSTRUCTED_FROM_BEFORE_AND_PRESERVED_BYTES'},schema_copies:{count:16,status:'BYTE_IDENTICAL_TO_CANONICAL_CONTRACT_1',local_references:564,closure_sha256:hash(await fs.readFile(root+cand+'schemas/SCHEMAS.lock.json'))},raw_reader_captures:2,main_task_ids:{count:57,status:'UNCHANGED'},application_boundary:{tracked_src_server_package_diff_bytes:0,whole_studio_runtime_SOURCE_01:'REQUIRED / NOT_RUN / NOT_WAIVED'},git:{branch,head,diff_check_exit_code:0},changes:diffs};await write('EVIDENCE_CHECKS.json',evidence);
const after={status:'FINALIZING_E1D_EVIDENCE',recorded_at_utc:new Date().toISOString(),path:'B_ONLY',branch,head,source_hash:pin.source_hash,prior_source_hash:pre.prior_source_hash,schema_closure_sha256:evidence.schema_copies.closure_sha256,E1d:'IMPLEMENTED_AND_TESTED',E1:'TECHNICAL_WORK_COMPLETE_OWNER_ACCEPTANCE_PENDING',E2:'NOT_STARTED',T01:'BLOCKED_NOT_CLOSED',T02:'NOT_STARTED',owner_license:'PROVISIONAL_OWNER_LICENSE_ACCEPTED_FOR_E1_PROGRESS',final_signature:'PENDING_WITHOUT_BLOCKING_E1',reference_default:'1.2.0',candidate_1_3_0:'PRESERVED',engine_binding:'NOT_CONFIGURED',runtime_honesty:'7 REQUIRED / NOT_RUN / NOT_WAIVED',governance_validation:'NOT_RUN',native_host_qualification:'NOT_RUN',independent_review:'NOT_PERFORMED',release_acceptance:'NOT_GRANTED',validation:'VALIDATION.json',acceptance:'E1_ACCEPTANCE.json',gaps:'GAPS.json',evidence_checks:'EVIDENCE_CHECKS.json',next_action:'Owner review/acceptance of E1 outputs before any E2; no other path or automatic promotion'};await write('AFTER.json',after);
console.log(JSON.stringify({step:'diffs_and_checks_saved',count:diffs.length}));const ctx=await exec(process.execPath,['tools/check_context_health.mjs'],{cwd:root,encoding:'buffer',timeout:60000,maxBuffer:4*1024*1024});await fs.writeFile(root+ev+'context-health.log',Buffer.concat([ctx.stdout,ctx.stderr]));const text=ctx.stdout.toString('utf8');if(!text.includes('Errors: 0, Warnings: 0'))throw Error('CONTEXT_COUNTS');const validation=await read('VALIDATION.json');validation.context_health={status:'PASS',exit_code:0,errors:0,warnings:0,estimated_bootstrap_tokens:Number(text.match(/Total Bootstrap Context: ~([0-9]+)/)[1]),log:'context-health.log'};validation.git_diff_check={exit_code:0,log:'git-diff-check.log'};await write('VALIDATION.json',validation);
const outputPaths=(await enumerate(root+ev)).filter(x=>x!=='AFTER.json').map(x=>ev+x);outputPaths.push(...pre.before.map(x=>x.path),...pre.new_paths);const outputs=[];for(const p of [...new Set(outputPaths)].sort()){const b=await fs.readFile(root+p);outputs.push({path:p,bytes:b.length,sha256:hash(b)});}after.status='COMPLETE_FOR_E1D_READ_CATALOG_PROFILE';after.completed_at_utc=new Date().toISOString();after.outputs=outputs;await write('AFTER.json',after);console.log(JSON.stringify({status:after.status,source_hash:pin.source_hash,source_files:physical.length,schemas:16,fields:17,kinds:13,changes:diffs.length,protected:pre.protected_inputs.length,bootstrap_tokens:validation.context_health.estimated_bootstrap_tokens,candidate_tests:'63/63',studio_tests:'41/41',E1:after.E1,E2:after.E2,T01:after.T01}));
