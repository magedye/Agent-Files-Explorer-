+    "license": { "$ref": "#/$defs/text" },
+    "signed": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["method", "identity"],
+      "properties": {
+        "method": { "$ref": "#/$defs/text" },
+        "identity": { "$ref": "#/$defs/text" }
