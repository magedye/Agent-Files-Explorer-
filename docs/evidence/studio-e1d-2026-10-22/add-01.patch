+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://aghr.invalid/contracts/rc3/aghr.schema.json",
+  "title": "DRAFT — AGHR package manifest, schemaVersion 1.2",
