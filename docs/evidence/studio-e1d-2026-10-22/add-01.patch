+    "compatibility": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["agents", "targets"],
+      "properties": {
+        "agents": { "$ref": "#/$defs/texts" },
+        "targets": {
+          "type": "object",
+          "minProperties": 1,
+          "additionalProperties": {
+            "type": "object",
+            "additionalProperties": false,
+            "properties": {
+              "file": { "$ref": "#/$defs/text" },
+              "dir": { "$ref": "#/$defs/text" },
+              "budgetBytes": { "type": "integer", "minimum": 1 },
+              "imports": { "$ref": "#/$defs/texts" }
+            },
+            "oneOf": [ { "required": ["file"] }, { "required": ["dir"] } ]
+          }
+        }
+      }
+    },
+    "validation": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["strict", "coreKindsOnly", "requireEvalForPriority", "requireTechnicalEnforcementFor", "requireSkillQualificationFor", "enforceSkillStateHonesty", "enforceDocumentationConsistency", "enforceAuthorityLevel"],
