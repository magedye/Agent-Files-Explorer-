+  "type": "object",
+  "additionalProperties": false,
+  "required": ["id", "name", "version", "schemaVersion", "owner", "license", "compatibility", "validation"],
+  "properties": {
+    "id": { "$ref": "#/$defs/text" },
+    "name": { "$ref": "#/$defs/text" },
+    "version": { "$ref": "#/$defs/text" },
+    "schemaVersion": { "const": "1.2" },
