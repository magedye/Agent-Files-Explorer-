diff --git a/docs/evidence/studio-e1d-2026-10-22/before/empty.snapshot b/governance_packages/candidates/AGHR_rc3_Core_Candidate/schemas/state.schema.json
index e69de29..30cf0d7 100644
--- a/docs/evidence/studio-e1d-2026-10-22/before/empty.snapshot
+++ b/governance_packages/candidates/AGHR_rc3_Core_Candidate/schemas/state.schema.json
@@ -0,0 +1,37 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://aghr.invalid/contracts/rc3/state.schema.json",
+  "title": "CI-published .aghr/state.json — read-side contract",
+  "$comment": "Reference 12.1 and 14.1. Schema-valid publication metadata does not authenticate CI; publication and provenance checks belong to trusted CI and the Python engine.",
+  "type": "object", "additionalProperties": false,
+  "required": ["schemaVersion", "aghrVersion", "adoptionLevel", "domainLevels", "evalStatus", "skillQualification", "exceptions", "publication"],
+  "properties": {
+    "schemaVersion": { "const": "1.2" }, "aghrVersion": { "$ref": "common.schema.json#/$defs/Text" },
+    "adoptionLevel": { "$ref": "common.schema.json#/$defs/Level" },
+    "domainLevels": {
+      "type": "object", "additionalProperties": false, "required": ["instructions", "skills"],
+      "properties": { "instructions": { "$ref": "common.schema.json#/$defs/Level" }, "skills": { "$ref": "common.schema.json#/$defs/Level" } }
+    },
+    "evalStatus": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_OBSERVABLE", "UNKNOWN"] },
+    "skillQualification": { "type": "array", "uniqueItems": true, "items": { "$ref": "qualification.schema.json" } },
+    "exceptions": {
+      "type": "array", "items": {
+        "type": "object", "additionalProperties": false, "required": ["itemId", "expiresOn", "approvalRef", "evidence"],
+        "properties": { "itemId": { "$ref": "common.schema.json#/$defs/Text" }, "expiresOn": { "$ref": "common.schema.json#/$defs/Date" }, "approvalRef": { "$ref": "common.schema.json#/$defs/Text" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Artifact" } } }
+      }
+    },
+    "publication": {
+      "type": "object", "additionalProperties": false, "required": ["publisher", "ciRunRef", "commitHash", "publishedAt", "sourceEvidence"],
+      "properties": {
+        "publisher": { "const": "ci" }, "ciRunRef": { "$ref": "common.schema.json#/$defs/Text" },
+        "commitHash": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
+        "publishedAt": { "$ref": "common.schema.json#/$defs/Time" },
+        "sourceEvidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Artifact" } }
+      }
+    }
+  },
+  "allOf": [{
+    "if": { "properties": { "evalStatus": { "const": "PASS" } }, "required": ["evalStatus"] },
+    "then": { "properties": { "publication": { "properties": { "sourceEvidence": { "minItems": 1 } } } } }
+  }]
+}
