+      "type": "object", "additionalProperties": false, "required": ["gpg_key_id", "default_branch", "commit_message_template"],
+      "properties": { "gpg_key_id": { "type": ["string", "null"] }, "default_branch": { "$ref": "common.schema.json#/$defs/Text" }, "commit_message_template": { "$ref": "common.schema.json#/$defs/Text" } }
+    },
+    "GitPatch": {
+      "type": "object", "additionalProperties": false, "minProperties": 1,
+      "properties": { "gpg_key_id": { "type": ["string", "null"] }, "default_branch": { "$ref": "common.schema.json#/$defs/Text" }, "commit_message_template": { "$ref": "common.schema.json#/$defs/Text" } }
+    },
+    "Limits": { "type": "object", "additionalProperties": false, "required": ["eval", "qualify"], "properties": { "eval": { "$ref": "engine.schema.json#/$defs/Limits" }, "qualify": { "$ref": "engine.schema.json#/$defs/Limits" } } },
+    "LimitsPatch": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "eval": { "$ref": "engine.schema.json#/$defs/Limits" }, "qualify": { "$ref": "engine.schema.json#/$defs/Limits" } } },
+    "Host": {
+      "type": "object", "additionalProperties": false, "required": ["host", "binary_path", "version_detection", "budget_bytes"],
+      "properties": { "host": { "$ref": "common.schema.json#/$defs/Text" }, "binary_path": { "$ref": "common.schema.json#/$defs/Text" }, "version_detection": { "type": "object", "additionalProperties": false, "required": ["kind", "args"], "properties": { "kind": { "const": "argv" }, "args": { "$ref": "api.execution.schema.json#/$defs/VerifyRequest/properties/args" } } }, "budget_bytes": { "type": "integer", "minimum": 1 } }
+    },
+    "HostsPatch": { "type": "object", "additionalProperties": false, "required": ["hosts"], "properties": { "hosts": { "type": "array", "items": { "$ref": "#/$defs/Host" } } } },
+    "Security": {
+      "type": "object", "additionalProperties": false, "required": ["binding", "audit_retention_days", "token_rotation"],
+      "properties": { "binding": { "const": "127.0.0.1" }, "audit_retention_days": { "type": "integer", "minimum": 1 }, "token_rotation": { "const": "per_session" } }
+    },
+    "SecurityPatch": {
+      "type": "object", "additionalProperties": false, "minProperties": 1,
+      "properties": { "binding": { "const": "127.0.0.1" }, "audit_retention_days": { "type": "integer", "minimum": 1 }, "token_rotation": { "const": "per_session" } }
+    },
+    "SigningResult": {
+      "type": "object", "additionalProperties": false, "required": ["status", "key_id", "evidence", "repository_written"],
+      "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_OBSERVABLE"] }, "key_id": { "type": ["string", "null"] }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Artifact" } }, "reason": { "$ref": "common.schema.json#/$defs/Text" }, "repository_written": { "const": false } },
+      "allOf": [{ "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] }, "then": { "properties": { "key_id": { "$ref": "common.schema.json#/$defs/Text" }, "evidence": { "minItems": 1 } } }, "else": { "required": ["reason"] } }]
+    }
+  }
+}
