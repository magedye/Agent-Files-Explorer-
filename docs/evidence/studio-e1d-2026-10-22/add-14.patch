+    "sources": {
+      "type": "object", "additionalProperties": false, "required": ["package", "canonical_state", "runtime_evidence"],
+      "properties": { "package": { "const": "read_only" }, "canonical_state": { "const": "read_only" }, "runtime_evidence": { "const": "read_only" } }
+    },
+    "engine": { "$ref": "engine.schema.json" },
+    "limits": { "$ref": "#/$defs/Limits" },
+    "resource_controls": {
+      "type": "object", "additionalProperties": false, "required": ["require_qualified_process_tree_adapter", "unavailable_adapter_action", "overflow_status"],
+      "properties": { "require_qualified_process_tree_adapter": { "const": true }, "unavailable_adapter_action": { "const": "block" }, "overflow_status": { "const": "resource_limit_exceeded" } }
+    },
+    "authorization": {
+      "type": "object", "additionalProperties": false, "required": ["simulated_role_grants_permissions", "approvals_invalidated_on_proposal_change"],
+      "properties": { "simulated_role_grants_permissions": { "const": false }, "approvals_invalidated_on_proposal_change": { "const": true } }
+    },
+    "git": { "$ref": "#/$defs/Git" }, "hosts": { "type": "array", "items": { "$ref": "#/$defs/Host" } }, "security": { "$ref": "#/$defs/Security" },
+    "intake": {
+      "type": "object", "additionalProperties": false, "required": ["watcher_enabled", "allowed_extensions", "result"],
+      "properties": { "watcher_enabled": { "type": "boolean" }, "allowed_extensions": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": [".md", ".yaml", ".json"] } }, "result": { "const": "draft_change_package_only" } }
+    }
+  },
+  "$defs": {
+    "PrincipalBinding": {
+      "type": "object", "additionalProperties": false, "required": ["principal", "roles"],
+      "properties": { "principal": { "$ref": "common.schema.json#/$defs/Text" }, "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Role" } } }
+    },
+    "RolesPatch": { "type": "object", "additionalProperties": false, "required": ["bindings"], "properties": { "bindings": { "type": "array", "items": { "$ref": "#/$defs/PrincipalBinding" } } } },
