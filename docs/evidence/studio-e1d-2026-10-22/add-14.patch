+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://aghr.invalid/contracts/rc3/settings.schema.json",
+  "title": "Settings YAML normalized JSON view and typed settings patches",
+  "type": "object", "additionalProperties": false,
+  "required": ["contract_revision", "listen", "authentication", "storage", "sources", "engine", "limits", "resource_controls", "authorization", "git", "hosts", "security", "intake"],
+  "properties": {
+    "contract_revision": { "const": "contract.1" },
+    "listen": { "type": "object", "additionalProperties": false, "required": ["host"], "properties": { "host": { "const": "127.0.0.1" } } },
