+      "allOf": [{ "if": { "properties": { "mode": { "const": "memory" } }, "required": ["mode"] }, "then": { "properties": { "database": { "const": ":memory:" }, "filesystem_writes": { "const": false } } }, "else": { "required": ["authorization_ref"], "properties": { "filesystem_writes": { "const": true } } } }]
