{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVIDENCE",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "TEST",
        "INSPECTION",
        "POLICY",
        "RUNTIME",
        "EVALUATION"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "BLOCKED",
        "ERROR",
        "NOT_APPLICABLE"
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "command_or_method": {
      "type": "string",
      "minLength": 1
    },
    "target_count": {
      "type": "integer",
      "minimum": 0
    },
    "tests_executed": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "producer": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "criterion_ids",
    "kind",
    "result",
    "candidate_sha256",
    "environment_id",
    "started_at",
    "finished_at",
    "command_or_method",
    "target_count",
    "tests_executed",
    "artifacts",
    "limitations",
    "producer"
  ],
  "additionalProperties": false
}
