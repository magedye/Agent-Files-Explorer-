{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STATE",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_id": {
      "type": "string",
      "minLength": 0
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "description",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "outcome",
          "criteria"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "goal_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "IMPLEMENTED",
              "VERIFIED",
              "BLOCKED",
              "CANCELLED"
            ]
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "blocker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "description",
          "goal_id",
          "status",
          "criterion_ids",
          "depends_on",
          "blocker"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "TEST",
              "INSPECTION",
              "POLICY",
              "RUNTIME",
              "EVALUATION"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED",
              "ERROR",
              "NOT_APPLICABLE"
            ]
          },
          "candidate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "command_or_method": {
            "type": "string",
            "minLength": 1
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "tests_executed": {
            "type": "integer",
            "minimum": 0
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "producer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "criterion_ids",
          "kind",
          "result",
          "candidate_sha256",
          "environment_id",
          "started_at",
          "finished_at",
          "command_or_method",
          "target_count",
          "tests_executed",
          "artifacts",
          "limitations",
          "producer"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED",
              "DEFERRED",
              "WITHDRAWN"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "resume_condition": {
            "type": "string",
            "minLength": 0
          },
          "resolution_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "work_id",
          "description",
          "status",
          "blocking",
          "owner",
          "resume_condition",
          "resolution_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "ADOPTION",
              "CHANGE",
              "EXCEPTION",
              "ACCEPTANCE",
              "ACTIVATION",
              "DEFER",
              "WITHDRAW"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "authority",
          "scope",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "candidate_sha256",
    "environment_id",
    "goals",
    "work",
    "checks",
    "pending",
    "decisions",
    "next_action"
  ],
  "additionalProperties": false
}
