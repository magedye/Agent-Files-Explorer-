{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STATE",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_id": {
      "type": "string",
      "minLength": 0
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "description",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "outcome",
          "criteria"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "goal_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "IMPLEMENTED",
              "VERIFIED",
              "BLOCKED",
              "CANCELLED"
            ]
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "blocker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "description",
          "goal_id",
          "status",
          "criterion_ids",
          "depends_on",
          "blocker"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "TEST",
              "INSPECTION",
              "POLICY",
              "RUNTIME",
              "EVALUATION"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED",
              "ERROR",
              "NOT_APPLICABLE"
            ]
          },
          "candidate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "command_or_method": {
            "type": "string",
            "minLength": 1
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "tests_executed": {
            "type": "integer",
            "minimum": 0
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "producer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "criterion_ids",
          "kind",
          "result",
          "candidate_sha256",
          "environment_id",
          "started_at",
          "finished_at",
          "command_or_method",
          "target_count",
          "tests_executed",
          "artifacts",
          "limitations",
          "producer"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED",
              "DEFERRED",
              "WITHDRAWN"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "resume_condition": {
            "type": "string",
            "minLength": 0
          },
          "resolution_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "work_id",
          "description",
          "status",
          "blocking",
          "owner",
          "resume_condition",
          "resolution_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "ADOPTION",
              "CHANGE",
              "EXCEPTION",
              "ACCEPTANCE",
              "ACTIVATION",
              "DEFER",
              "WITHDRAW"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "authority",
          "scope",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "INTAKE",
            "REQUIREMENTS",
            "DESIGN",
            "PLANNING",
            "IMPLEMENTATION",
            "VERIFICATION",
            "REVIEW",
            "MERGE",
            "RELEASE",
            "OPERATION",
            "MAINTENANCE",
            "RETIREMENT"
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "GUIDED",
            "CONTINUOUS_WITHIN_GRANT",
            "UNSELECTED"
          ]
        },
        "grant_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_baseline_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_scope_complete": {
          "type": "boolean"
        },
        "git_observation": {
          "type": "object",
          "properties": {
            "branch": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_branch": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "remote_checked": {
              "type": "boolean"
            },
            "unmerged_branches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "evidence_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "branch",
            "default_branch",
            "observed_at",
            "remote_checked",
            "unmerged_branches",
            "evidence_ref"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "OBSERVED_VIOLATION",
                  "SUSPECTED_DEVIATION",
                  "MONITORING_GAP",
                  "APPROVED_REPLAN",
                  "EXTERNAL_BLOCKER"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "UNASSESSED"
                ]
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "observed": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "RESOLVED",
                  "ACCEPTED_LIMITATION"
                ]
              },
              "decision_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retest_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "rule_id",
              "kind",
              "severity",
              "expected",
              "observed",
              "evidence_ids",
              "status",
              "decision_ref",
              "retest_evidence_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "phase",
        "execution_mode",
        "grant_ref",
        "plan_baseline_ref",
        "measurement_scope_complete",
        "git_observation",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "candidate_sha256",
    "environment_id",
    "goals",
    "work",
    "checks",
    "pending",
    "decisions",
    "next_action"
  ],
  "additionalProperties": false
}
