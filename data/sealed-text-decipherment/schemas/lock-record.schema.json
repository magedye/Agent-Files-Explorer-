{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sealed-text/lock-record.schema.json",
  "title": "Staged Lock Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_type",
    "locked_at_utc",
    "corpus_hash",
    "candidate_ids",
    "unknowns",
    "lock_hash",
    "immutable"
  ],
  "properties": {
    "lock_type": {
      "type": "string",
      "enum": [
        "LOCK_TRANSCRIPTION",
        "LOCK_STRUCTURE",
        "LOCK_INTERNAL_SEMANTICS",
        "LOCK_INTERNAL_RESULT"
      ]
    },
    "locked_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "corpus_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "strongest_counterevidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsification_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "holdout_status": {
      "type": "string",
      "enum": [
        "unseen",
        "revealed",
        "not_available"
      ]
    },
    "source_zones_opened_after_lock": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lock_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "immutable": {
      "const": true
    }
  }
}
