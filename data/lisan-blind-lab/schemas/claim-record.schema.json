{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sealed-text/claim-record.schema.json",
  "title": "Decipherment Claim Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_type",
    "evidence_layer",
    "status",
    "statement",
    "evidence_refs",
    "falsification_condition"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "GLYPH_IDENTITY",
        "ALLOGRAPH_EQUIVALENCE",
        "READING_DIRECTION",
        "WRITING_SYSTEM_TYPE",
        "SEGMENTATION",
        "PHONETIC_VALUE",
        "MORPHEME_FUNCTION",
        "MORPHOLOGICAL_PARADIGM",
        "SYNTACTIC_FUNCTION",
        "LEXEME_MEMBERSHIP",
        "SEMANTIC_CORE",
        "LOCAL_MEANING",
        "TRANSLATION",
        "TEXTUAL_INTERPRETATION"
      ]
    },
    "evidence_layer": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CANDIDATE",
        "INTERNALLY_SUPPORTED",
        "PREDICTIVE",
        "EXTERNALLY_CORROBORATED",
        "INDEPENDENTLY_REVIEWED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "competing_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "strongest_counterevidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "falsification_condition": {
      "type": "string",
      "minLength": 1
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    }
  }
}
