{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lisan.local/schemas/blind-run-manifest.schema.json",
  "title": "بيان تشغيل المختبر الأعمى",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "target",
    "test_type",
    "methodology_version",
    "skill_version",
    "canonical_profile",
    "canonical_text_artifact_id",
    "canonical_text_artifact_hash",
    "canonical_text_status",
    "allowed_sources",
    "blocked_sources",
    "prior_access",
    "source_isolation_verdict",
    "expected_corpus_policy",
    "output_level",
    "blindness_scope"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "test_type": {
      "type": "string",
      "minLength": 1
    },
    "methodology_version": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_profile": {
      "const": "HAFS_ASIM_MADINAH"
    },
    "canonical_text_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_text_artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_text_status": {
      "enum": [
        "VERIFIED",
        "PROVISIONAL_USER_SUPPLIED",
        "UNAVAILABLE"
      ]
    },
    "allowed_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prior_access": {
      "const": "DENIED"
    },
    "source_isolation_verdict": {
      "enum": [
        "READY_FOR_BLIND_RUN",
        "BLIND_ISOLATION_NOT_VERIFIED",
        "SOURCE_PROFILE_INCOMPLETE",
        "CANONICAL_TEXT_ARTIFACT_UNAVAILABLE"
      ]
    },
    "expected_corpus_policy": {
      "enum": [
        "ALL",
        "FULL_INDEX_PLUS_DEEP_SAMPLE"
      ]
    },
    "output_level": {
      "enum": [
        "FULL_LAYERED_REPORT",
        "CONTROLLED_CONCISE_SUMMARY",
        "STATUS_ONLY"
      ]
    },
    "blindness_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentary_isolation",
        "parametric_prior_risk"
      ],
      "properties": {
        "documentary_isolation": {
          "enum": [
            "VERIFIED",
            "NOT_VERIFIED"
          ]
        },
        "parametric_prior_risk": {
          "const": "PRESENT"
        },
        "claim": {
          "const": "DOCUMENTARY_AND_SESSION_ISOLATION_ONLY"
        }
      }
    }
  }
}