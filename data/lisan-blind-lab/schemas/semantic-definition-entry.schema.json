{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lisan.local/schemas/semantic-definition-entry.schema.json",
  "title": "مدخل سجل التعريفات الدلالية",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_or_lexeme",
    "status",
    "root_core_definition_ar",
    "semantic_boundary",
    "decisive_contexts",
    "structurally_sensitive_contexts",
    "nearest_lexemes",
    "local_realizations",
    "rejected_candidates",
    "coverage",
    "provenance",
    "reopen_condition",
    "regression_tests",
    "lock_status",
    "owner_acceptance_status",
    "registry_adoption_status",
    "language_profile",
    "evidence_matrix_ref",
    "semantic_exclusion_ledger_ref"
  ],
  "properties": {
    "root_or_lexeme": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "BLIND_TESTED",
        "PROVISIONAL",
        "AGREED",
        "REGRESSION_BACKED",
        "UNRESOLVED",
        "REOPENED"
      ]
    },
    "root_core_definition_ar": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "REQUIRED",
        "PERMITTED",
        "EXCLUDED",
        "UNKNOWN"
      ],
      "properties": {
        "REQUIRED": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "PERMITTED": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "EXCLUDED": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "UNKNOWN": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisive_contexts": {
      "type": "array"
    },
    "structurally_sensitive_contexts": {
      "type": "array"
    },
    "nearest_lexemes": {
      "type": "array"
    },
    "local_realizations": {
      "type": "array"
    },
    "rejected_candidates": {
      "type": "array"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_confirmed_occurrences",
        "indexed_occurrences",
        "deeply_analyzed_occurrences",
        "index_coverage",
        "deep_analysis_coverage",
        "context_diversity_status",
        "structural_stability"
      ],
      "properties": {
        "total_confirmed_occurrences": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "indexed_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "deeply_analyzed_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "index_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "deep_analysis_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "context_diversity_status": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "COMPLETE_FOR_IDENTIFIED_CLUSTERS",
            "UNKNOWN"
          ]
        },
        "structural_stability": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "ROOT_ASSIGNMENT_UNCERTAIN",
            "FORM_IDENTITY_UNCERTAIN",
            "UNKNOWN"
          ]
        },
        "positive_core_robustness": {
          "enum": [
            "NONE",
            "LOW",
            "MODERATE",
            "STRONG",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "negative_determination_robustness": {
          "enum": [
            "NONE",
            "LOW",
            "MODERATE",
            "STRONG",
            "HIGH",
            "UNKNOWN"
          ]
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "reopen_condition": {
      "type": "string"
    },
    "regression_tests": {
      "type": "array"
    },
    "lock_status": {
      "enum": [
        "NOT_LOCKED",
        "LOCK_BLOCKED",
        "LOCK_INTERNAL_RESULT"
      ]
    },
    "owner_acceptance_status": {
      "enum": [
        "PENDING_OWNER_REVIEW",
        "OWNER_ACCEPTED",
        "OWNER_REJECTED",
        "REOPENED"
      ]
    },
    "registry_adoption_status": {
      "enum": [
        "NOT_ADOPTED",
        "PROPOSED_DIFF",
        "PROVISIONAL",
        "AGREED",
        "REGRESSION_BACKED",
        "UNRESOLVED"
      ]
    },
    "language_profile": {
      "const": "ARABIC_FIRST_BILINGUAL_IDENTIFIERS"
    },
    "evidence_matrix_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_exclusion_ledger_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "optional_interpretive_review_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}