{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lisan.local/schemas/morphological-operator-entry.schema.json",
  "title": "مدخل العامل الصرفي",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operator_id",
    "layer",
    "form_or_pattern",
    "structural_status",
    "semantic_status",
    "claim_scope",
    "semantic_candidate",
    "excluded_inferences",
    "next_test"
  ],
  "properties": {
    "operator_id": {
      "type": "string",
      "minLength": 1
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "deprecated": true
    },
    "layer": {
      "enum": [
        "اشتقاق اسمي",
        "تصريف/منظور",
        "جذر/بنية أساس",
        "حاوية بنيوية",
        "رباعي مجرد/حاوية فرعية",
        "صوت نحوي",
        "فئة صوتية للأساس",
        "قوة كلامية",
        "مزاج نحوي",
        "نمط اسمي/وصفي",
        "وزن فعلي مزيد"
      ]
    },
    "form_or_pattern": {
      "type": "string",
      "minLength": 1
    },
    "qac_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "structural_status": {
      "enum": [
        "PATTERN_CORPUS_PENDING",
        "PATTERN_COUNT_PENDING",
        "QAC_NOMINAL_ONLY",
        "QAC_ROOT_SINGLETON",
        "QAC_STRUCTURALLY_VERIFIED",
        "QAC_STRUCTURALLY_VERIFIED_SPARSE",
        "QAC_STRUCTURALLY_VERIFIED_SUBSET"
      ]
    },
    "token_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "root_candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "semantic_candidate": {
      "type": "string"
    },
    "local_realizations": {
      "type": "string"
    },
    "semantic_status": {
      "enum": [
        "CROSS_ROOT_CANDIDATE_UNAUDITED",
        "HYPOTHESIS_HIGH",
        "HYPOTHESIS_LOW",
        "HYPOTHESIS_MEDIUM",
        "LIMITED_EVIDENCE",
        "NO_SEMANTIC_CLAIM",
        "UNKNOWN"
      ]
    },
    "claim_scope": {
      "enum": [
        "CROSS_ROOT_CANDIDATE",
        "CROSS_ROOT_CANDIDATE_LIMITED",
        "CROSS_ROOT_CANDIDATE_UNQUANTIFIED",
        "PATTERN_CANDIDATE_UNVALIDATED",
        "ROOT_SPECIFIC_LIMITED",
        "STRUCTURAL_ONLY"
      ]
    },
    "confidence": {
      "type": "string"
    },
    "examples": {
      "type": "string"
    },
    "excluded_inferences": {
      "type": "string"
    },
    "next_test": {
      "type": "string"
    },
    "evidence_matrix": {
      "type": "string"
    },
    "audit_status": {
      "enum": [
        "UNAUDITED",
        "PARTIALLY_AUDITED",
        "REGRESSION_BACKED",
        "NOT_APPLICABLE"
      ]
    },
    "arabic_label": {
      "type": "string",
      "minLength": 1
    }
  }
}